	partition Distritos = m
		mode: import
		source =
				let
					Origen = Csv.Document(File.Contents(CarpetaDatos & "distritos.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
					Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
					Tipos = Table.TransformColumnTypes(Encabezados, {{"ubigeo", type text}, {"distrito", type text}, {"provincia", type text}, {"latitud", type number}, {"longitud", type number}, {"zona", type text}, {"lugar", type text}}, "en-US")
				in
					Tipos

